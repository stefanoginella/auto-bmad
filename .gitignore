# --- Local BMAD test install (kept out of the published plugin repo) ---
# This repo doubles as a dev sandbox: a full BMAD project is installed here so
# the orchestrator can be tested end-to-end. None of it belongs in the plugin.
_bmad/
_bmad-output/
.agents/
# .claude/ is ignored wholesale EXCEPT the one tracked maintainer skill below.
# (Git can't re-include a path under an excluded directory, so ignore the
# contents of each level and re-include the chain down to the skill.)
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/auto-bmad-compat-check/
# Legacy rendered delegate agents — no longer generated (the renderer is gone);
# kept ignored so a local host config never lands in the repo. .claude/* already
# covers .claude/agents/; .codex/ and .opencode/ are the Codex and opencode
# equivalents (.opencode/agent/ab-*.md + any local opencode config).
.codex/
.opencode/

# --- OS / editor noise ---
.DS_Store
*.swp
*~
.idea/
.vscode/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
